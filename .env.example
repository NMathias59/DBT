# Copiez ce fichier en ".env" (gitignored) et remplissez vos identifiants ClickHouse.
# Ensuite : chargez-le dans votre shell avant de lancer dbt, par ex. avec un outil
# comme `direnv`, ou en import ant les variables manuellement.

DBT_CH_HOST=localhost
DBT_CH_PORT=8123
DBT_CH_USER=default
DBT_CH_PASSWORD=
DBT_CH_SCHEMA=default
DBT_CH_SECURE=False
DBT_CH_DRIVER=http
